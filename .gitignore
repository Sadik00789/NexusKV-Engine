# NexusKV Engine .gitignore

# -----------------------------------------------------------------------------
# Rust & Cargo Build Artifacts
# -----------------------------------------------------------------------------
/target/
**/*.rs.bk
*.bk

# -----------------------------------------------------------------------------
# CUDA / C++ Compiled Objects & Libraries
# -----------------------------------------------------------------------------
csrc/*.o
*.o
*.obj
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib
*.ptx
*.cubin

# -----------------------------------------------------------------------------
# Next.js 15 & Node.js Frontend Artifacts
# -----------------------------------------------------------------------------
node_modules/
dashboard/node_modules/
dashboard/.next/
dashboard/out/
dashboard/build/
dashboard/.pnpm-store/
dashboard/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------------------------------
.env
.env*.local
.env.development
.env.test
.env.production

# -----------------------------------------------------------------------------
# Local agent state & decision log
# -----------------------------------------------------------------------------
.commandcode/
DECISIONS.md

# Model weights are downloaded locally, never committed.
/models/

# Measured benchmark JSON is written locally for evidence; never auto-committed.
/benches/results/

# Python bytecode from helper scripts.
__pycache__/
*.pyc

# -----------------------------------------------------------------------------
# Operating System & IDE Artifacts
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.vscode/
.idea/
*.swp
*.swo
*~
